{
  "name": "time-traveler",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:docs": "pnpm --filter docs dev",
    "dev:reader": "pnpm --filter reader dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check:deps": "node scripts/check-dependency-singletons.mjs",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "fix:coverage": "node scripts/fix-lcov-paths.mjs",
    "merge:coverage": "lcov-result-merger '{apps,packages}/*/coverage/lcov.info' coverage/lcov.info",
    "posttest:coverage": "mkdir -p coverage && pnpm fix:coverage && pnpm merge:coverage",
    "verify": "pnpm format:check && pnpm lint && pnpm check-types && pnpm check:deps && pnpm test:coverage && pnpm build",
    "storybook": "(cd packages/ui && pnpm run storybook)",
    "db:deploy": "supabase db push",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:stop": "supabase stop",
    "db:sync": "supabase db pull",
    "db:test": "supabase test db",
    "db:seed:admin": "node --experimental-strip-types ./scripts/seed-admin.mts",
    "db:seed:discovery": "node --experimental-strip-types ./scripts/seed-discovery.mts",
    "db:gen:migration": "supabase migration new",
    "db:gen:types": "supabase gen types typescript --local > ./packages/services/src/supabase/types.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^16.6.1",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "lcov-result-merger": "^6.0.0",
    "prettier": "^3.9.6",
    "supabase": "^2.116.0",
    "turbo": "^2.10.11",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  }
}
