# Public Supabase URL for browser/client usage.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public anonymous key for browser/client usage.
# NEEDS: Replace with your Supabase project's anon key for non-local environments.
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY

# Absolute base URL of the admin app used to build auth redirect URLs
# (emailRedirectTo, redirectTo) sent in Supabase confirmation/magic-link emails.
# Must be set in staging and production Vercel environment variables.
# Can be left unset in local dev — the app falls back to request headers.
# Example production value: https://admin.yourproject.com
# NEXT_PUBLIC_APP_URL=https://admin.yourproject.com

# Server-side service role key. Never expose this in client bundles.
# NEEDS: Replace with your Supabase project's service role key for non-local environments.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# Email for the local/dev admin user created by `pnpm db:seed:admin`.
# Optional — defaults to admin@timetraveler.local if unset.
# SEED_ADMIN_EMAIL=admin@timetraveler.local

# Password for the local/dev admin user created by `pnpm db:seed:admin`.
# Required to run db:seed:admin (and, indirectly, db:seed:discovery, which
# looks this user up but does not create it). No default — never commit a
# real value here.
# NEEDS: Set a password for local seeding.
SEED_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD